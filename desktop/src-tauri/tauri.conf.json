{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JetStream",
  "version": "0.1.29",
  "identifier": "gov.noaa.jetstream",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NOAA JetStream",
        "width": 1400,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Upload and manage data in Google Cloud Storage",
    "longDescription": "NOAA JetStream manages uploads from local folders to Google Cloud Storage, cloud-to-cloud sync and moves, and bucket audits.",
    "externalBin": ["binaries/jetstream-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
