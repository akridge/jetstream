# Environment variables for JetStream API

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database
# Default: per-user data dir (Windows %LOCALAPPDATA%\JetStream, macOS ~/Library/Application Support/JetStream,
# Linux ~/.local/share/jetstream). Override the folder with JETSTREAM_DATA_DIR or set a full URL:
# DATABASE_URL=sqlite:///./jetstream.db
